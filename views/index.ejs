<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Rutine</title>
    <link rel="stylesheet" type="text/css" href="/static/index.css" />
</head>
<body>
    <h1>🚋 Rutine</h1>

    <form method="POST" action="/todo" class="new-todo">
        <input placeholder="Ny todo" name="description" autocomplete="off" required autofocus />
        <button type="submit">Legg til</button>
    </form>

    <ul aria-label="Todos" class="todos">
    <% todos.forEach(todo => { %>
        <li class="todo" style="view-transition-name: todo-<%= todo.id %>">
            <span class="description"><%= todo.description %></span>

            <form method="POST" action="/todo/<%= todo.id %>/toggle" class="toggle-form">
                <input name="checked" type="checkbox" <%= todo.completed ? "checked" : "" %> />
                <button type="submit">Toggle</button>
            </form>

            <!-- Holdeplass 3: Delete-knappen og bekreftelsesdialogen. -->
        </li>
    <% }); %>
    </ul>
</body>
</html>
