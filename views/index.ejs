<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Rutine</title>
    <link rel="stylesheet" type="text/css" href="/static/index.css" />
</head>
<body>
    <h1>🚋 Rutine</h1>

    <form method="POST" action="/todo" class="new-todo">
        <input placeholder="New todo" name="description" autocomplete="off" required autofocus />
        <input type="submit" value="Submit" />
    </form>

    <ul aria-label="Todos" class="todos">
    <% todos.forEach(todo => { %>
        <% const confirmDeleteId = `confirm-delete-${todo.id}`; %>

        <li class="todo" style="view-transition-name: todo-<%= todo.id %>">
            <details name="example">
                <summary>
                    <form method="POST" action="/todo/<%= todo.id %>/toggle" class="toggle-form">
                        <input name="checked" type="checkbox" <%= todo.completed ? "checked" : "" %> />
                        <input type="submit" value="Toggle" />
                        <span class="description"><%= todo.description %></span>
                    </form>
                </summary>

                <button command="show-modal" commandfor="<%= confirmDeleteId %>">Delete</button>

                <dialog id="<%= confirmDeleteId %>">
                    <h2>Please confirm</h2>

                    <form method="POST" action="/todo/<%= todo.id %>/delete">
                        <p>Are you sure you wish to delete this todo?</p>

                        <div class="dialog-actions">
                            <button type="button" command="close" commandfor="<%= confirmDeleteId %>">Cancel</button>
                            <button type="submit">Delete</button>
                        </div>
                    </form>
                </dialog>
            </details>
        </li>
    <% }); %>
    </ul>
</body>
</html>
