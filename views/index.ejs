<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Rutine</title>
    <link rel="stylesheet" type="text/css" href="/static/index.css" />
</head>
<body>
    <h1>🚋 Rutine</h1>

    <form method="POST" action="/todo" class="new-todo">
        <input placeholder="Ny todo" name="description" autocomplete="off" required />
        <button type="submit">Legg til</button>
    </form>

    <ul aria-label="Todos" class="todos">
    <% todos.forEach(todo => { %>
        <li class="todo" style="view-transition-name: todo-<%= todo.id %>">
            <span class="description"><%= todo.description %></span>

            <!-- Holdeplass 2: skjemaet som toggler completed. -->

            <!-- Holdeplass 3: Delete-knappen og bekreftelsesdialogen. -->
        </li>
    <% }); %>
    </ul>
</body>
</html>
